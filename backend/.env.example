# Copy to backend/.env and fill in. Never commit the real .env.

APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (Supabase or local docker). Plain postgresql:// URLs are converted
# to postgresql+asyncpg:// automatically.
# Supabase direct:  postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Supabase pooler:  postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local docker:     postgresql://aitwin:aitwin@localhost:54329/aitwin_dev
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Set true when connecting through PgBouncer/Supavisor in transaction mode (port 6543).
DATABASE_USE_PGBOUNCER=false

# Embeddings (backend only)
#
# Option A — OpenAI directly: set OPENAI_API_KEY and leave LITELLM_API_BASE empty.
#
# Option B — LiteLLM proxy (OpenAI-compatible): run e.g.
#   litellm --model text-embedding-3-small --port 4000
# or point at your LiteLLM gateway, then set:
#   LITELLM_API_BASE=http://localhost:4000   (host only, not …/chat/completions)
# If your Supabase DB password has special characters, URL-encode them in DATABASE_URL (@ → %40).
#   LITELLM_API_KEY=<litellm master key, or same as OPENAI_API_KEY if your proxy uses it>
# Model name must match what LiteLLM expects (often openai/text-embedding-3-small).
OPENAI_API_KEY=sk-your-key-here
LITELLM_API_BASE=
LITELLM_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LiteLLM multi-provider routing example:
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=4
EMBEDDING_BATCH_SIZE=96

# Chat / RAG (backend only). Chat uses the same LiteLLM/OpenAI credentials as embeddings.
OPENAI_CHAT_MODEL=gpt-6.1-sol
# Some proxy models reject non-default temperature; the app retries without it automatically.
CHAT_TEMPERATURE=0.2
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_CANDIDATES=30
MAX_CONTEXT_TOKENS=10000
MAX_CHAT_HISTORY_MESSAGES=10

# LangGraph chat orchestration (Subtask 3)
LANGGRAPH_MAX_RETRIEVAL_ATTEMPTS=2
LANGGRAPH_MAX_ANSWER_REPAIRS=1
LANGGRAPH_ENABLE_DEBUG_METADATA=false
LANGGRAPH_CHECKPOINTING_ENABLED=false
# If checkpointing is on with Supabase, prefer a direct/session DB URL (port 5432), not the pooler (6543):
# LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://postgres:...@db....supabase.co:5432/postgres
LANGGRAPH_WORKFLOW_TIMEOUT_SECONDS=120
LANGGRAPH_MAX_EVIDENCE_ITEMS=24
LANGGRAPH_GRAPH_VERSION=twin-v4
LANGGRAPH_RECOVERY_ENABLED=true
LANGGRAPH_MAX_RECOVERY_ATTEMPTS=2
LANGGRAPH_RETRY_BACKOFF_SECONDS=1

# Memory & summaries (Subtask 4) — requires migration 0003
MEMORY_ENABLED=true
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_INTERVAL_MESSAGES=6
MEMORY_RETRIEVAL_TOP_K=8
MEMORY_MAX_RECORDS_PER_USER=500
MEMORY_MIN_IMPORTANCE=0
MEMORY_CONTEXT_TOKEN_BUDGET=2000
CONVERSATION_SUMMARY_ENABLED=true
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=12
CONVERSATION_SUMMARY_MAX_TOKENS=800
CONVERSATION_SUMMARY_INCREMENTAL=true

# Supabase Storage (backend only - the service-role key must NEVER reach Streamlit)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents
STORAGE_TIMEOUT_SECONDS=60

# Uploads and chunking
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=100
# Semantic breakpoints: split where consecutive sentence similarity is at/below this percentile (0–1).
SEMANTIC_CHUNK_BREAKPOINT_PERCENTILE=0.25

# Ingestion: a 'processing' document older than this may be reclaimed by a retry.
INGESTION_STALE_AFTER_SECONDS=900

# PDF OCR (Tesseract): sparse/scanned pages and embedded raster figures
PDF_PAGE_OCR_ENABLED=true
PDF_PAGE_OCR_SCALE=2.0
PDF_PAGE_OCR_MIN_TEXT_CHARS=20
PDF_EMBEDDED_IMAGE_OCR_ENABLED=true
PDF_EMBEDDED_IMAGE_MIN_PIXELS=4096
PDF_MAX_EMBEDDED_IMAGES_PER_PAGE=5
PDF_TABLE_EXTRACTION_ENABLED=true

# Development identity (LOCAL DEVELOPMENT ONLY - not authentication).
# Every request is treated as this owner. Any other AUTH_MODE rejects requests.
AUTH_MODE=development
DEV_OWNER_ID=00000000-0000-0000-0000-000000000001
